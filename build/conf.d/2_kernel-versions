# major stable kernelversions to use
STABLE="7.2"
LONGTERM="6.12"
LEGACY="6.1"

# Version selection per kernel branch:
# - default: use the prebuilt version stored in kernel/<branch>/<version>,
#   fall back to the latest version from kernel.org if there is none
# - BUILDKERNELS set: always use the latest version from kernel.org,
#   build/run.d/1_kernels compiles it only if it is not already stored
KRNLORG_VERSIONS=""
KVERSIONS=""
for kbranch in "stable:$STABLE" "longterm:$LONGTERM" "legacy:$LEGACY"; do
    kbname="${kbranch%%:*}"
    kbmajor="${kbranch#*:}"
    kbvers=""
    if [ -z "$BUILDKERNELS" ]; then
        kbvers="$(ls -1 "$KERNELDIR/$kbname" 2> /dev/null | grep -E "^${kbmajor//./\\.}\.[0-9]+$" | sort -V | tail -1)"
    fi
    if [ -z "$kbvers" ]; then
        # query kernel.org only once
        if [ -z "$KRNLORG_VERSIONS" ]; then
            KRNLORG_VERSIONS="$(wget -q https://kernel.org -O - | grep tarball | grep -oE 'linux-[0-9]+\.[0-9]+\.[0-9]+\.tar\.xz' | sed -e 's|^linux-||' -e 's|\.tar\.xz$||')"
        fi
        kbvers="$(echo "$KRNLORG_VERSIONS" | grep -E "^${kbmajor//./\\.}\.[0-9]+$" | sort -V | tail -1)"
    fi
    if [ -z "$kbvers" ]; then
        echo "Cannot determine $kbname kernel version for $kbmajor!" >&2
        return 1
    fi
    KVERSIONS="$KVERSIONS $kbvers"
done
unset kbranch kbname kbmajor kbvers
KVERSARRAY=($KVERSIONS)
