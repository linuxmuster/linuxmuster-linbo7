#!/bin/bash
#
# Filename     : 2z_archive-modules
# Description  : archive modules, store new kernels as prebuilt and install them to the package
# Signed-off by: thomas@linuxmuster.net
# Assisted by  : Claude
# Date         : 20261003
#

# read build environment
for item in build/conf.d/*; do source "$item" || exit 1; done

# iterate over kernels
for kvers in ${KVERSARRAY[@]}; do

    # get kernel name & version
    cd "$BUILDROOT"
    source "$KNAMES"

    # prebuilt kernel: install stored modules archive
    if [ -n "$kprebuilt" ]; then
        echo "Using prebuilt $kname modules $kvers from $kstore."
        [ -n "$KERNELSONLY" ] && continue
        cp "$kstore/modules.tar.xz" "$kinst" || exit 1
        continue
    fi

    echo "Packing $kname modules $kvers ..."

    if [ ! -s "$kmodarc" ]; then
        cd "$kroot"
        tar -c -I 'xz -T0' -f "$kmodarc" "lib/modules/$kvers" || exit 1
    fi

    # store the freshly built kernel as prebuilt, the gen_init_cpio source is
    # needed by 99_linbofs to create linbofs without kernel source tree
    echo "Storing $kname kernel $kvers in $kstore ..."
    kstoretmp="$kstore.tmp"
    rm -rf "$kstoretmp"
    mkdir -p "$kstoretmp"
    cp "$klinbo" "$kmodarc" "$kstoretmp" || exit 1
    cp "$kcfg" "$kstoretmp/config" || exit 1
    cp "$ksrc/usr/gen_init_cpio.c" "$kstoretmp" || exit 1
    echo "$kvers" > "$kstoretmp/version"
    rm -rf "$kstore"
    mv "$kstoretmp" "$kstore" || exit 1

    # move older versions of this kernel branch to the archive
    mkdir -p "$KERNELARCHIVE/$kname"
    for item in "$KERNELDIR/$kname"/*; do
        [ "$item" = "$kstore" ] && continue
        # leftovers of interrupted builds are not archived
        case "$item" in
            *.tmp) rm -rf "$item"; continue ;;
        esac
        echo "Archiving old prebuilt kernel $item ..."
        rm -rf "$KERNELARCHIVE/$kname/$(basename "$item")"
        mv "$item" "$KERNELARCHIVE/$kname/" || exit 1
    done

    # keep only the last versions in the archive
    ls -1 "$KERNELARCHIVE/$kname" | sort -V | head -n -"$KERNELARCHIVE_KEEP" | while read -r item; do
        echo "Removing archived kernel $KERNELARCHIVE/$kname/$item ..."
        rm -rf "$KERNELARCHIVE/$kname/$item"
    done

    [ -n "$KERNELSONLY" ] && continue

    # copy modules archive to package
    cp "$kmodarc" "$kinst" || exit 1

done
